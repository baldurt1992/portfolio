# Copia a `.env` en local. En Hostinger, configura estos valores en
# Deployments → Settings & Redeploy → Environment Variables.

# --- SEO (inyectado en build time) ---
# Producción: https://baldurdev.com
# Local: opcional; puedes usar http://localhost:3000.
# Barra final opcional; el proyecto la normaliza.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Formulario de contacto (Cloudflare Worker + Email Sending) ---
# Producción: https://contact.baldurdev.com/
# Local: wrangler dev del worker → http://127.0.0.1:8787/
NUXT_PUBLIC_CONTACT_API_URL=

# --- Cloudflare Turnstile (widget; si falta, el form usa mailto) ---
# Site key: Turnstile → sitios → tu widget.
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
