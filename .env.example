# Copia a `.env` en local. En Hostinger, configura estos valores en
# Deployments → Settings & Redeploy → Environment Variables.

# --- SEO (inyectado en build time) ---
# Producción: https://baldurdev.com
# Local: opcional; puedes usar http://localhost:3000.
# Barra final opcional; el proyecto la normaliza.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# --- EmailJS (formulario de contacto; siguen siendo necesarios en CI como secrets) ---
# En producción se configuran como variables de entorno de Hostinger.
NUXT_PUBLIC_EMAILJS_PUBLIC_KEY=
NUXT_PUBLIC_EMAILJS_SERVICE_ID=
NUXT_PUBLIC_EMAILJS_TEMPLATE_ID=

# --- Cloudflare Turnstile (opcional; si falta site key o verify URL, el formulario se comporta como antes) ---
# Site key: Turnstile → sitios → tu widget.
# Verify URL:
# - Cloudflare Pages: https://tu-proyecto.pages.dev/api/verify-turnstile
# - Worker (wrangler): https://<nombre-en-wrangler.toml>.<subcuenta>.workers.dev/  (POST a la raíz; barra final OK)
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
NUXT_PUBLIC_TURNSTILE_VERIFY_URL=
